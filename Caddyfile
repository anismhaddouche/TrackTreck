# Caddy reverse proxy — auto HTTPS via Let's Encrypt
# Variables are read from the container environment (see docker-compose.prod.yml).

{
    email {$ACME_EMAIL}
    # For initial debugging only, swap to the staging CA:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# --- Admin / frontend -----------------------------------------------------
{$APP_HOST} {
    encode zstd gzip
    reverse_proxy app:80
}

# --- n8n ------------------------------------------------------------------
{$N8N_HOST} {
    encode zstd gzip
    reverse_proxy n8n:5678 {
        flush_interval -1
    }
}

# --- Evolution API --------------------------------------------------------
{$EVOLUTION_HOST} {
    encode zstd gzip
    reverse_proxy evolution-api:8080 {
        flush_interval -1
    }
}

# --- Supabase (self-hosted) -----------------------------------------------
# Kong is the single public entrypoint for Auth, REST, Storage, Meta and Studio.
{$SUPABASE_HOST} {
    encode zstd gzip
    # Allow large Storage uploads.
    request_body {
        max_size 100MB
    }
    reverse_proxy supabase-kong:8000 {
        flush_interval -1
    }
}
