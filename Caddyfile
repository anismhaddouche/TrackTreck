# Caddy reverse proxy — HTTP-only, single :80 server with path-based routing.
# Variables are read from the container environment (see docker-compose.prod.yml).
#
# Public URL layout (no DNS, no TLS):
#   http://{$PUBLIC_HOST}/admin     -> app:80              (Vite SPA, base=/admin/)
#   http://{$PUBLIC_HOST}/n8n       -> n8n:5678            (n8n must run under /n8n/)
#   http://{$PUBLIC_HOST}/api       -> evolution-api:8080  (prefix stripped)
#   http://{$PUBLIC_HOST}/supabase  -> supabase-kong:8000  (prefix stripped)
#
# NOTE: n8n is reverse-proxied with `handle` (NOT `handle_path`) because it is
# explicitly configured with N8N_PATH=/n8n/ and expects to receive the /n8n
# prefix from the upstream request. Everything else uses `handle_path` to strip
# the public prefix so upstream services see their native paths.

{
    # Disable the automatic HTTPS pipeline: we are HTTP-only for now.
    auto_https off
}

:80 {
    encode zstd gzip

    # Allow large Storage uploads (Supabase storage).
    request_body {
        max_size 100MB
    }

    # --- Admin / frontend (Vite SPA, built with base=/admin/) -------------
    redir /admin /admin/ 308
    handle_path /admin/* {
        reverse_proxy app:80
    }

    # --- n8n (configured with N8N_PATH=/n8n/ — DO NOT strip the prefix) ---
    redir /n8n /n8n/ 308
    handle /n8n/* {
        reverse_proxy n8n:5678 {
            flush_interval -1
        }
    }

    # --- Evolution API ----------------------------------------------------
    redir /api /api/ 308
    handle_path /api/* {
        reverse_proxy evolution-api:8080 {
            flush_interval -1
        }
    }

    # --- Supabase (Kong gateway) ------------------------------------------
    # Kong's own routes (/auth/v1/, /rest/v1/, /storage/v1/, /pg/, /) match the
    # stripped path, so handle_path is the right choice here.
    redir /supabase /supabase/ 308
    handle_path /supabase/* {
        reverse_proxy supabase-kong:8000 {
            flush_interval -1
        }
    }

    # --- Default ----------------------------------------------------------
    handle {
        respond "TrackTreck — try /admin, /n8n, /api or /supabase" 404
    }
}
