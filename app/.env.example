# Supabase (frontend uses anon key only — never put service role here)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: n8n webhook to trigger manual extraction from the admin upload form.
# Leave empty to disable manual upload submission (the UI will show a TODO state).
VITE_N8N_INGESTION_WEBHOOK_URL=
