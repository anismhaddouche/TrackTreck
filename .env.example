# =============================================================================
# TrackTreck — production environment (Hetzner CX23+ / self-hosted Supabase)
# Copy this file to `.env` on the VPS and replace every `change_me` value.
# NEVER commit `.env`.
# =============================================================================

# --- General ---------------------------------------------------------------
DOMAIN_NAME=example.com
TZ=Europe/Paris

# Public hostnames — must resolve to the VPS public IP. For a quick test
# without a custom domain, use sslip.io (replace with your VPS IP).
APP_HOST=admin.example.com
N8N_HOST=n8n.example.com
EVOLUTION_HOST=api.example.com
SUPABASE_HOST=supabase.example.com

# Email used by Let's Encrypt / Caddy for certificate notices.
ACME_EMAIL=admin@example.com

# --- Supabase (SELF-HOSTED on this VPS) -----------------------------------
# Public URL of the Supabase Kong gateway (must match SUPABASE_HOST above).
SUPABASE_URL=https://supabase.example.com
SUPABASE_SITE_URL=https://admin.example.com
SUPABASE_URI_ALLOW_LIST=https://admin.example.com,https://n8n.example.com

# Supabase Postgres password. Used internally by every Supabase service.
# Generate with:  openssl rand -hex 24
SUPABASE_DB_PASSWORD=change_me_supabase_db_password

# JWT secret used to sign anon/service-role JWTs and validate auth tokens.
# REQUIRED: at least 32 chars. Generate with:  openssl rand -hex 32
SUPABASE_JWT_SECRET=change_me_jwt_secret_min_32_chars

# anon + service-role JWTs derived from SUPABASE_JWT_SECRET. Generate them
# AFTER you pick SUPABASE_JWT_SECRET — see README §5 ("Generate Supabase keys").
# Each value is a long JWT string (~200 chars).
SUPABASE_ANON_KEY=change_me_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=change_me_service_role_jwt

# Default storage bucket used by the admin app.
SUPABASE_STORAGE_BUCKET=travel-offer-assets

# Studio (Supabase admin UI) is exposed behind Basic Auth at https://${SUPABASE_HOST}/
STUDIO_USERNAME=admin
STUDIO_PASSWORD=change_me_studio_password
STUDIO_DEFAULT_ORG=TrackTreck
STUDIO_DEFAULT_PROJECT=tracktreck

# Disable open signup by default — flip to "false" if you need it.
SUPABASE_DISABLE_SIGNUP=true
# Auto-confirm emails when no SMTP is configured (single-user demo). Set to
# "false" + fill SMTP block once you have email delivery in place.
SUPABASE_MAILER_AUTOCONFIRM=true
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
SUPABASE_SMTP_ADMIN_EMAIL=admin@example.com

# --- Frontend / admin app -------------------------------------------------
# Optional: webhook the admin UI calls to trigger manual ingestion in n8n.
# Leave empty to disable the upload form.
VITE_N8N_INGESTION_WEBHOOK_URL=https://n8n.example.com/webhook/manual-ingestion

# --- n8n ------------------------------------------------------------------
# REQUIRED: 32+ random chars. Used to encrypt credentials stored in n8n.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_long_random_string
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# --- Evolution API --------------------------------------------------------
# Master API key (header `apikey`).  Generate with: openssl rand -hex 24
EVOLUTION_API_KEY=change_me_evolution_api_key

# --- Postgres (Evolution API only — NOT shared with Supabase) -------------
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=change_me_evolution_db_password
EVOLUTION_DB_NAME=evolution

# --- Redis (Evolution API only) -------------------------------------------
REDIS_PASSWORD=change_me_redis_password
