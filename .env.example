# =============================================================================
# TrackTreck — production environment (Hetzner CX23+ / self-hosted Supabase)
# Copy this file to `.env` on the VPS and replace every `change_me` value.
# NEVER commit `.env`.
#
# Public access is HTTP-only — no DNS, no sslip.io, no Let's Encrypt, no TLS.
# Path-based routing on the VPS public IP. Verified live URLs:
#
#   http://<PUBLIC_HOST>/admin              Admin SPA
#   http://<PUBLIC_HOST>/n8n                n8n editor
#   http://<PUBLIC_HOST>/api                Evolution API (REST)
#   http://<PUBLIC_HOST>/manager/login      Evolution Manager (UI)
#   http://<PUBLIC_HOST>/supabase           Supabase Kong gateway
#   http://<PUBLIC_HOST>/supabase/rest/v1   PostgREST (app + n8n call this)
#   http://<PUBLIC_HOST>/project/default    Supabase Studio
#   http://<PUBLIC_HOST>/storage/v1/...     Supabase Storage absolute route
# =============================================================================

# --- General ---------------------------------------------------------------
TZ=Europe/Paris

# VPS public IPv4 (or IP:port). Used by every service for absolute public URLs.
PUBLIC_HOST=157.90.166.243

# Public base URLs (must stay consistent with PUBLIC_HOST + the Caddy routes).
APP_PUBLIC_URL=http://157.90.166.243/admin
N8N_PUBLIC_URL=http://157.90.166.243/n8n
EVOLUTION_PUBLIC_URL=http://157.90.166.243/api
SUPABASE_PUBLIC_URL=http://157.90.166.243/supabase

# --- Supabase (SELF-HOSTED on this VPS) -----------------------------------
# Public URL of the Supabase Kong gateway (path-based). Must equal SUPABASE_PUBLIC_URL.
SUPABASE_URL=http://157.90.166.243/supabase
SUPABASE_SITE_URL=http://157.90.166.243/admin
SUPABASE_URI_ALLOW_LIST=http://157.90.166.243/admin,http://157.90.166.243/n8n

# Supabase Postgres password. Used internally by every Supabase service.
# Generate with:  openssl rand -hex 24
SUPABASE_DB_PASSWORD=change_me_supabase_db_password

# JWT secret used to sign anon/service-role JWTs and validate auth tokens.
# REQUIRED: at least 32 chars. Generate with:  openssl rand -hex 32
SUPABASE_JWT_SECRET=change_me_jwt_secret_min_32_chars

# anon + service-role JWTs derived from SUPABASE_JWT_SECRET. Generate them
# AFTER you pick SUPABASE_JWT_SECRET — see README §5 ("Generate Supabase keys").
# Each value is a long JWT string (~200 chars).
SUPABASE_ANON_KEY=change_me_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=change_me_service_role_jwt

# Default storage bucket used by the admin app.
SUPABASE_STORAGE_BUCKET=travel-offer-assets

# --- Supabase Storage — S3 protocol credentials ---------------------------
# Used by clients (n8n nodes, scripts) that hit Storage's S3-compatible
# endpoint (http://supabase-storage:5000/s3 from inside Docker).
# Generate with: openssl rand -hex 16  (id) / openssl rand -hex 32 (secret)
S3_REGION=local
S3_PROTOCOL_ACCESS_KEY_ID=change_me
S3_PROTOCOL_ACCESS_KEY_SECRET=change_me

# Studio (Supabase admin UI) is exposed behind Basic Auth at /supabase
STUDIO_USERNAME=admin
STUDIO_PASSWORD=change_me_studio_password
# Kong Basic Auth for the Supabase Studio route. Leave equal to STUDIO_* unless
# you want to expose Studio under a different credential pair than the rest of
# the Kong dashboard plugins. scripts/render-kong-config.sh falls back to
# STUDIO_USERNAME / STUDIO_PASSWORD if these are empty.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me_studio_password
STUDIO_DEFAULT_ORG=TrackTreck
STUDIO_DEFAULT_PROJECT=tracktreck

# Disable open signup by default — flip to "false" if you need it.
SUPABASE_DISABLE_SIGNUP=true
# Auto-confirm emails when no SMTP is configured (single-user demo). Set to
# "false" + fill SMTP block once you have email delivery in place.
SUPABASE_MAILER_AUTOCONFIRM=true
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
SUPABASE_SMTP_ADMIN_EMAIL=admin@example.com

# --- Frontend / admin app -------------------------------------------------
# Optional: webhook the admin UI calls to trigger manual ingestion in n8n.
# Leave empty to disable the upload form.
VITE_N8N_INGESTION_WEBHOOK_URL=http://157.90.166.243/n8n/webhook/manual-ingestion

# --- n8n ------------------------------------------------------------------
# REQUIRED: 32+ random chars. Used to encrypt credentials stored in n8n.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_long_random_string
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# Externally n8n is reachable at http://<PUBLIC_HOST>/n8n, but Caddy strips the
# /n8n prefix with `handle_path` before forwarding, so n8n itself sees / and
# N8N_PATH must stay at the root. Setting N8N_PATH=/n8n/ here breaks asset
# MIME types — confirmed during VPS debugging.
N8N_PROTOCOL=http
N8N_HOST=157.90.166.243
N8N_PATH=/
N8N_EDITOR_BASE_URL=http://157.90.166.243/n8n
WEBHOOK_URL=http://157.90.166.243/n8n/
N8N_SECURE_COOKIE=false
# Must be "false" so workflows can read process.env (LLAMA_PARSE_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY) from Code / Function nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# LlamaParse API key consumed by ingestion workflows running in n8n.
LLAMA_PARSE_API_KEY=change_me

# --- Evolution API --------------------------------------------------------
# Master API key (header `apikey`).  Generate with: openssl rand -hex 24
EVOLUTION_API_KEY=change_me_evolution_api_key

# --- Postgres (Evolution API only — NOT shared with Supabase) -------------
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=change_me_evolution_db_password
EVOLUTION_DB_NAME=evolution

# --- Redis (Evolution API only) -------------------------------------------
REDIS_PASSWORD=change_me_redis_password

# =============================================================================
# DEPRECATED / UNUSED — kept here for reference only.
# The active path-based stack does NOT read these. They were used by the old
# subdomain + Let's Encrypt layout (admin.example.com, sslip.io, etc.) and
# can be deleted from your local `.env` once you no longer roll back.
# =============================================================================
# DOMAIN_NAME=example.com
# APP_HOST=admin.example.com
# N8N_HOST_SUBDOMAIN=n8n.example.com
# EVOLUTION_HOST=api.example.com
# SUPABASE_HOST=supabase.example.com
# ACME_EMAIL=ops@example.com
