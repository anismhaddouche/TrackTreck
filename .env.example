# =============================================================================
# TrackTreck — production environment (Hetzner CX23)
# Copy this file to `.env` on the VPS and replace every `change_me` value.
# NEVER commit `.env`.
# =============================================================================

# --- General ---------------------------------------------------------------
DOMAIN_NAME=example.com
TZ=Europe/Paris

# Subdomains — must have A records pointing to the VPS public IP.
APP_HOST=admin.example.com
N8N_HOST=n8n.example.com
EVOLUTION_HOST=api.example.com

# Email used by Let's Encrypt / Caddy for certificate notices.
ACME_EMAIL=admin@example.com

# --- Supabase (EXTERNAL — Supabase Cloud) ---------------------------------
# These are baked into the frontend bundle at build time (Vite).
# Only the anon key belongs in the frontend; service role MUST stay server-side (n8n).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=change_me_anon_key
SUPABASE_STORAGE_BUCKET=travel-offer-assets
# Service role: store as an n8n credential in the UI, do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=change_me_service_role_key

# Optional: webhook the admin UI calls to trigger manual ingestion in n8n.
# Leave empty to disable the upload form.
VITE_N8N_INGESTION_WEBHOOK_URL=https://n8n.example.com/webhook/manual-ingestion

# --- n8n ------------------------------------------------------------------
# REQUIRED: 32+ random chars. Used to encrypt credentials stored in n8n.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_long_random_string
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# --- Evolution API --------------------------------------------------------
# Master API key used to authenticate every request (header `apikey`).
# Generate with: openssl rand -hex 24
EVOLUTION_API_KEY=change_me_evolution_api_key

# --- Postgres (Evolution API only) ----------------------------------------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=evolution

# --- Redis (Evolution API only) -------------------------------------------
REDIS_PASSWORD=change_me_redis_password
